# Uyiz admin panel — environment
#
# Copy to `.env.local` for local development. On Vercel these go in the
# project's Environment Variables, not in a file.

# Where the API lives. The `/api/v1` suffix is PART OF THIS VALUE: the http
# client appends bare endpoint paths like `/admin/stats` to it. Leaving the
# suffix off produces 404s on every screen with no other symptom.
#
# This variable is compiled into the browser bundle (NEXT_PUBLIC_), so it is
# public by design. Never put a server secret behind a NEXT_PUBLIC_ name.
NEXT_PUBLIC_API_URL=https://maklersizkvartira-production.up.railway.app/api/v1

# Reminder, because it is the other half of making this panel work at all:
# the panel calls the API cross-origin from the browser, and the backend's
# CORS allowlist forbids "*" in production. The domain this panel is served
# from must be added to CORS_ORIGINS on the API side (Railway) or every
# request fails preflight with an opaque network error.

# ─── Admin login second factor (2FA) ─────────────────────────────────────────
# The panel REFUSES to run 2FA without all three of these: /api/auth/2fa/send
# and /api/auth/2fa/verify answer 503 {"error":"2fa_not_configured"} and
# nobody logs in. That is deliberate. These three used to have hardcoded
# fallbacks — a live bot token, the real operations group and a key spelled
# out in the source — which meant anyone reading the repository could forge
# the second factor. A 2FA that silently degrades to a published key is worse
# than one that is visibly off.
#
# Server-side only: no NEXT_PUBLIC_ prefix, so these never enter the browser
# bundle. Set them in the Vercel project's Environment Variables.

# Peppers the sha256 of the one-time code held server-side. Must be at least
# 32 characters; a shorter or missing value is treated as "not configured".
# Generate one, do not invent one: openssl rand -hex 32
SECRET_KEY=

# The bot that delivers the code. Create it with @BotFather and add it to the
# group below AS AN ADMINISTRATOR — a bot that is only a member cannot post
# to a supergroup.
TELEGRAM_2FA_BOT_TOKEN=

# The group the code is posted to, WITH its leading minus (e.g.
# -1001234567890). A positive id is read by the Bot API as a user id and every
# send fails with "Bad Request: chat not found".
TELEGRAM_2FA_CHANNEL_ID=
