# ─── Frontend environment (Vite) ─────────────────────────────────────────────
# Only VITE_* variables are exposed to the browser. Never put a secret here:
# everything in this file ships to every visitor in the JS bundle.
#
# The previous build shipped a live Gemini API key (VITE_GEMINI_API_KEY) and a
# Firebase key to the browser. AI moderation now runs server-side; there is no
# AI key on the client at all.

# API base. Leave empty to use the same origin (recommended in production,
# behind one domain). Set it when the API is on a different host.
VITE_API_URL=

# Firebase is only used to obtain a Google ID token, which the backend then
# verifies against Google's public keys. These values are public by design.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
