# Frontend (Vite) — set these on Vercel, not here.
#
# Everything with a VITE_ prefix is compiled into the bundle and served to every
# visitor. Never put a server secret behind one: that is exactly how the old
# Gemini key leaked. The values below are public by design.

# Where the API lives. The only variable the site cannot work without.
# The Railway hostname still carries the old project name. That is deliberate:
# it is invisible to visitors, and renaming the service would have to land in
# four coupled places at once (here, admin/.env.example, vercel.json's
# sitemap-listings rewrite, and both Vercel projects' environments).
VITE_API_URL=https://maklersizkvartira-production.up.railway.app/api/v1

# Google sign-in. Firebase web config is publishable: the backend verifies the
# ID token's signature against Google's certificates before trusting any claim.
#
# The project id still reads maklersiz-uy because a Firebase project id is
# IMMUTABLE — only its display label can be renamed. It must match Railway's
# FIREBASE_PROJECT_ID exactly; a mismatch makes the backend reject every Google
# ID token and sign-in fails with nothing visible in the browser. Change these
# two lines only if you create a brand new Firebase project, in which case the
# API key and app id below have to be reissued from it as well.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=maklersiz-uy.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=maklersiz-uy
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Address lookup — the highest-leverage variable on this list after the API URL
# ---------------------------------------------------------------------------
# The "detect my location" button on the listing form turns GPS coordinates
# into a region, a district and a street. With a Yandex Geocoder key it uses
# Yandex, which knows Uzbek district and mahalla names and answers in Uzbek.
# With the key EMPTY, every single lookup falls through to Nominatim, whose
# Uzbek district coverage is patchy and which rate-limits everyone sharing an
# IP to one request per second — so owners get the wrong tuman, or none.
#
# Get one from https://developer.tech.yandex.ru, and note that it must be a
# GEOCODER API key specifically. The JS Maps key below is a different product
# and Yandex answers a geocoder request made with it "403 Invalid api key" —
# verified against this project's own key. The code does fall back to the maps
# key when this one is blank, which is only useful if you were issued a key
# that covers both plans; with a maps-only key it turns every lookup into a
# failed request before Nominatim picks it up. Leave this blank until you have
# a real geocoder key.
#
# Restrict it to your domain in the Yandex console: like every VITE_ value it
# is public once it is in the bundle.
VITE_YANDEX_GEOCODER_API_KEY=

# The map widget's key — the JS Maps API, a separate product and quota from the
# geocoder above.
#
# Leaving this blank is fine: src/components/map/engine.ts carries the live key
# as its default, so the map works without any configuration here. Set it only
# to point a deployment at a DIFFERENT key — a second one for staging, say, so
# the two do not share a quota.
#
# Whichever key is in use, restrict it by HTTP-Referer in the Yandex Cabinet.
# It is served inside the JS bundle to every visitor, so the referrer list is
# the only thing stopping another site spending your quota.
VITE_YANDEX_MAPS_API_KEY=

# The public origin of the SITE. Canonical tags, hreflang, Open Graph URLs and
# both sitemaps are built from it. SET IT ON VERCEL — this file is
# documentation, not a loaded environment. If it is missing there the sitemap
# generator falls back to a hard-coded default, and a wrong default publishes a
# whole sitemap for a host the site is not served from, with a green build and
# no warning.
VITE_SITE_URL=https://uyiz.uz

# Google Analytics 4. Leave empty and nothing is loaded: no script, no cookie,
# no global. The tag is fetched when the page is idle and never for crawlers.
# Consent handling for EU visitors is a decision for the operator.
VITE_GA_MEASUREMENT_ID=
