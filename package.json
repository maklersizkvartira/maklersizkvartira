{
  "name": "uyiz.uz",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run build:client && npm run build:ssr && npm run build:prerender && npm run build:sitemap && npm run seo:audit:strict",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "backend:dev": "cd backend_python && python3 run_dev.py",
    "backend:test": "cd backend_python && python -m pytest",
    "backend:migrate": "cd backend_python && alembic upgrade head",
    "backend:admin": "cd backend_python && python -m scripts.create_admin",
    "verify:ui": "node scripts/verify-ui.mjs",
    "build:client": "vite build",
    "mobile:sync": "npm run build:client && npx cap sync",
    "mobile:open:android": "npx cap open android",
    "mobile:open:ios": "npx cap open ios",
    "build:ssr": "vite build --ssr src/entry-server.tsx",
    "build:prerender": "node scripts/prerender.mjs",
    "build:sitemap": "node scripts/generate-sitemap.mjs",
    "seo:audit": "node scripts/seo-audit.mjs --warn",
    "seo:audit:strict": "node scripts/seo-audit.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@phosphor-icons/react": "^2.1.10",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "enhanced-resolve": "^5.24.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
