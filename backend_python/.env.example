# ─── Runtime ─────────────────────────────────────────────────────────────────
ENVIRONMENT=production
PORT=5000
LOG_LEVEL=INFO
# Number of reverse proxies in front of the app (Railway = 1). Controls which
# X-Forwarded-For entry is trusted as the client IP.
TRUSTED_PROXY_COUNT=1

# ─── Database ────────────────────────────────────────────────────────────────
# Railway injects this. The plain postgres:// form is upgraded automatically.
#
# NOT part of the rebrand: the Railway API host
# (maklersizkvartira-production.up.railway.app), the Postgres service and its
# container name are platform identifiers. Renaming a Railway service changes
# its public host, which breaks every client pointed at the old one and the
# internal DNS name this URL resolves through. Only the local development
# database was renamed, to `uyiz`.
DATABASE_URL=postgresql://user:password@host:5432/railway

# ─── Secrets — GENERATE THESE, never reuse the examples ──────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Decrypts the admin "reveal password" copy. Keep it OUT of the database host:
# a stolen DB dump is worthless without it.
PASSWORD_REVEAL_KEY=
PASSWORD_REVEAL_ENABLED=true

# ─── Public site origin ──────────────────────────────────────────────────────
# The origin of the SITE, not of this API. /sitemap-listings.xml is served here
# but proxied onto that host, so every <loc> it publishes has to name it — a
# sitemap listing URLs for a host it is not served from is only honoured when
# both hosts are verified in Search Console. Only change this if the domain does.
# This is the NEW domain: the sitemap must publish uyiz.uz URLs, never the old
# maklersizuy.uz ones, or the 301 chain is what Google indexes.
SITE_URL=https://uyiz.uz

# ─── CORS — exact origins only, never "*" ────────────────────────────────────
# Every browser origin that calls this API. That is BOTH deployments: the site,
# and the admin panel, which is its own Vercel project on its own domain and is
# no longer served from this service. Leave the admin origin out and the panel
# loads fine and then fails on every request.
#
# The old maklersizuy.uz origins stay in the list for as long as that domain
# still resolves (it is a permanent 301 onto uyiz.uz). CORS is matched exactly —
# scheme and host, no wildcards — so an origin that is missing does not degrade,
# it fails every request with no Access-Control-Allow-Origin and nothing in the
# API log to explain it. Remove them only once the old domain is gone.
CORS_ORIGINS=https://uyiz.uz,https://www.uyiz.uz,https://admin.uyiz.uz,https://maklersizuy.uz,https://www.maklersizuy.uz,https://admin.maklersizuy.uz

# ─── Auth policy ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_ACCESS_TOKEN_TTL_MINUTES=30
ADMIN_REFRESH_TOKEN_TTL_DAYS=1
PASSWORD_MIN_LENGTH=8
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ─── OTP ─────────────────────────────────────────────────────────────────────
# 4..8 only: the SMS provider refuses any other length, one message at a time.
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_DAY=10
# Must stay false in production — true returns the SMS code in the response.
OTP_DEBUG_RETURN_CODE=false

# ─── SMS (DevSMS) ────────────────────────────────────────────────────────────
# Codes go through the provider's universal-OTP templates, because Eskiz only
# delivers text that matches a template approved in advance. Free text is
# refused per message, silently, and only for real users.
#
# Check the token and the remaining credit at any time with:
#   python -m scripts.check_sms                      (free, read-only)
#   python -m scripts.check_sms --send --phone "+998 ..."   (sends one, billed)
SMS_ENABLED=true
DEVSMS_API_URL=https://devsms.uz/api
DEVSMS_API_TOKEN=
DEVSMS_SENDER=4546
# The company name inside a verification SMS. Screened by the provider on every
# send; twenty consecutive rejections suspend the account for a day, so this is
# a variable rather than a literal. Register "Uyiz" with DevSMS/Eskiz BEFORE
# switching this over: until the new name is approved every send is rejected,
# which means nobody can register, sign in by code or reset a password. Roll
# back with SMS_ENABLED=false if that happens.
DEVSMS_SERVICE_NAME=Uyiz

# ─── Telegram operations group ───────────────────────────────────────────────
# Every outward notification the backend sends goes through these two: the AI
# lead ("a visitor asked us to call them"), the support callback, and the
# closing summary of an assistant conversation. Both empty means all of that
# is off — and off SILENTLY, which is why app/services/telegram.py now logs
# telegram.not_configured rather than returning a bare False.
#
# Create the bot with @BotFather, then ADD IT TO THE GROUP as an
# administrator. A bot that is only a member cannot post to a supergroup.
TELEGRAM_BOT_TOKEN=

# The group's numeric id, WITH its leading minus. A supergroup or channel id
# is negative and starts -100 (e.g. -1001234567890). Copied out of a client,
# an export or a bot log it very often loses the sign, and a positive id is
# read by the Bot API as a USER id: getChat answers
#   {"ok":false,"error_code":400,"description":"Bad Request: chat not found"}
# and every send fails. config.normalise_chat_id repairs an obvious case, but
# write it correctly here rather than relying on the repair. Get it from
# @RawDataBot in the group, or from getUpdates after posting once.
TELEGRAM_GROUP_ID=

# Optional SECOND bot and chat, used only for the AI transcripts. Leave both
# empty and the transcripts go to the bot and group above, which is the normal
# setup; set them when the AI feed is busy enough to want a channel of its
# own. Each falls back independently, so setting only one is fine.
TELEGRAM_AI_BOT_TOKEN=
TELEGRAM_AI_CHAT_ID=

# ─── AI providers (server-side only — never expose to the browser) ───────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
#
# A SECOND, separate key, and only for reading what the assistant costs.
# OpenAI publishes no credit balance for an ordinary sk-... key, and the one
# route that does answer — the organisation Costs API — rejects anything but
# an admin key. Create it at platform.openai.com under Organization -> Admin
# keys; it starts with sk-admin-. Left empty, the panel shows usage counts
# and says the money figure needs this key rather than guessing at one.
OPENAI_ADMIN_KEY=
#
# The reasoning tier, used only when a turn actually has to think: an owner
# asking why their listing is not performing, a multi-step request, a turn
# that already called a tool and has to make sense of what came back. Empty
# means "same as OPENAI_MODEL", so nothing changes until this is set on
# purpose.
OPENAI_MODEL_SMART=
#
# How many tool round trips one turn may take before the loop gives up. Four
# covers "search, look at one of them, save it" with room to spare; past that
# the model is looping rather than working.
AI_MAX_TOOL_STEPS=4

# ─── Support desk (the assistant hands these out) ────────────────────────────
# The numbers the assistant may give a visitor who asks for a human, highest
# priority first, comma-separated. Changing them is a variable change, not a
# deploy.
SUPPORT_PHONES=+998937188885,+998777850737
# For people who would rather write than call. EMPTY MEANS "we do not offer
# this route": the assistant omits it entirely rather than handing out a link
# that goes nowhere.
SUPPORT_TELEGRAM=https://t.me/uyiz
# When somebody is actually there, in Asia/Tashkent. The assistant quotes it
# so it can say "they will call you back in the morning" instead of promising
# a call at midnight.
SUPPORT_HOURS=09:00-21:00

# ─── Google / Firebase sign-in ───────────────────────────────────────────────
# Required to verify ID tokens. Empty disables Google sign-in rather than
# accepting unverified identities.
#
# NOT part of the rebrand. This is a Google-side project id, not display text:
# the expected token issuer is derived from it as
# https://securetoken.google.com/{project_id} and `aud` must equal it exactly.
# The live value stays `maklersiz-uy`. Renaming it to match the brand, without
# actually creating a new Firebase project and repointing every client, kills
# Google sign-in silently — and creating one would give every Google-linked
# account a new Firebase uid, which is an account migration, not a rename.
FIREBASE_PROJECT_ID=

# ─── Misc ────────────────────────────────────────────────────────────────────
USD_TO_UZS_RATE=12700
