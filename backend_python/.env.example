# ─── Runtime ─────────────────────────────────────────────────────────────────
ENVIRONMENT=production
PORT=5000
LOG_LEVEL=INFO
# Number of reverse proxies in front of the app (Railway = 1). Controls which
# X-Forwarded-For entry is trusted as the client IP.
TRUSTED_PROXY_COUNT=1

# ─── Database ────────────────────────────────────────────────────────────────
# Railway injects this. The plain postgres:// form is upgraded automatically.
DATABASE_URL=postgresql://user:password@host:5432/railway

# ─── Secrets — GENERATE THESE, never reuse the examples ──────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Decrypts the admin "reveal password" copy. Keep it OUT of the database host:
# a stolen DB dump is worthless without it.
PASSWORD_REVEAL_KEY=
PASSWORD_REVEAL_ENABLED=true

# ─── CORS — exact origins only, never "*" ────────────────────────────────────
CORS_ORIGINS=https://maklersizuy.uz,https://www.maklersizuy.uz

# ─── Auth policy ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_MIN_LENGTH=8
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ─── OTP ─────────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_DAY=10
# Must stay false in production — true returns the SMS code in the response.
OTP_DEBUG_RETURN_CODE=false

# ─── SMS (DevSMS) ────────────────────────────────────────────────────────────
SMS_ENABLED=true
DEVSMS_API_TOKEN=
DEVSMS_SENDER=4546

# ─── Telegram operations group ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=

# ─── AI providers (server-side only — never expose to the browser) ───────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Google / Firebase sign-in ───────────────────────────────────────────────
# Required to verify ID tokens. Empty disables Google sign-in rather than
# accepting unverified identities.
FIREBASE_PROJECT_ID=

# ─── Misc ────────────────────────────────────────────────────────────────────
USD_TO_UZS_RATE=12700
