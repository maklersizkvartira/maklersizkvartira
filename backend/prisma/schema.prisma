datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-musl"]
}

model User {
  id         String   @id @default(uuid())
  name       String
  phone      String   @unique
  password   String?
  avatar     String?
  role       String   @default("OWNER")
  trustScore Int      @default(90)
  isVerified Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  listings   Listing[]
  aiSessions AISession[]
}

model Listing {
  id            String   @id @default(uuid())
  title         String
  description   String
  price         Float
  depositPrice  Float?
  rooms         Int
  area          Float?
  floor         Int?
  totalFloors   Int?
  propertyType  String?  @default("APARTMENT")
  region        String?
  district      String?
  address       String?
  latitude      Float?
  longitude     Float?
  metroStation  String?
  metroDistanceMinutes Int?
  universityName String?
  universityDistanceMinutes Int?
  utilitiesIncluded Boolean @default(false)
  furnished     Boolean @default(false)
  petsAllowed   Boolean @default(false)
  parking       Boolean @default(false)
  internet      Boolean @default(false)
  airConditioning Boolean @default(false)
  washingMachine Boolean @default(false)
  images        String[]
  videoUrl      String?
  hasVirtualTour Boolean @default(false)
  isRoommate    Boolean @default(false)
  roommateGender String?
  roommateSpotsAvailable Int?
  contactTelegram String?
  preferredContactTime String?

  aiCheckStatus String   @default("APPROVED")
  trustScore    Int      @default(50)
  riskScore     Int      @default(0)
  aiRiskReasons String[]
  safetyBadges  String[]

  viewsCount    Int      @default(0)
  favoritesCount Int     @default(0)
  contactCount  Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id])
}

// Shield AI Chat Session — one per anonymous guest (by sessionKey from localStorage)
model AISession {
  id         String      @id @default(uuid())
  sessionKey String      @unique
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  messages   AIMessage[]
}

// Each turn in a Shield AI conversation
model AIMessage {
  id        String    @id @default(uuid())
  sessionId String
  session   AISession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String    // "user" | "assistant"
  content   String
  createdAt DateTime  @default(now())

  @@index([sessionId, createdAt])
}
