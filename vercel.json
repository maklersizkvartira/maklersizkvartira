{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "_domainRedirectNote": "The old-domain -> uyiz.uz redirects are DELIBERATELY NOT HERE YET. maklersizuy.uz is still the host this site is served from, and uyiz.uz does not resolve; a `permanent: true` redirect from the live host to a dead one takes the whole site down AND is cached by every browser that sees it once, so the outage outlives the fix. Add the two rules below only once https://uyiz.uz answers 200 on its own, and add them in the same change that points the new domain at this project:\n  {\"source\": \"/:path*\", \"has\": [{\"type\": \"host\", \"value\": \"maklersizuy.uz\"}], \"destination\": \"https://uyiz.uz/:path*\", \"permanent\": true},\n  {\"source\": \"/:path*\", \"has\": [{\"type\": \"host\", \"value\": \"www.maklersizuy.uz\"}], \"destination\": \"https://uyiz.uz/:path*\", \"permanent\": true}",
  "redirects": [
    {
      "source": "/blog/maklersiz-uy-topish",
      "destination": "/blog/uy-ijaraga-olish-qollanma",
      "permanent": true
    },
    {
      "source": "/ru/blog/maklersiz-uy-topish",
      "destination": "/ru/blog/uy-ijaraga-olish-qollanma",
      "permanent": true
    },
    {
      "source": "/en/blog/maklersiz-uy-topish",
      "destination": "/en/blog/uy-ijaraga-olish-qollanma",
      "permanent": true
    },
    {
      "source": "/search",
      "destination": "/elonlar",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap-listings.xml",
      "destination": "https://maklersizkvartira-production.up.railway.app/sitemap-listings.xml"
    },
    {
      "source": "/e/:slug",
      "destination": "/e/index.html"
    },
    {
      "source": "/ru/e/:slug",
      "destination": "/ru/e/index.html"
    },
    {
      "source": "/en/e/:slug",
      "destination": "/en/e/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
        },
        { "key": "X-DNS-Prefetch-Control", "value": "on" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sitemap(.*).xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
