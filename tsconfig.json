{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    // On, and it costs nothing: the codebase already satisfies it in full.
    // It was off, which meant `strictNullChecks` was off with it, which meant
    // TypeScript was not checking null or undefined anywhere — so "tsc is
    // clean" said much less than it looked like it said. Turning it on
    // surfaced five real holes, one of them a crash: the account page
    // dereferenced `currentUser` in a hook, and pressing "Chiqish" on that
    // page sets it to null, so signing out went to a white screen.
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
